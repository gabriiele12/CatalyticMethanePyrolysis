        234            VARIABLE=MASS-FLOW UOM="kg/sec"
        235        LIMITS "1" "10000"
        236
        237    DESIGN-SPEC H2SPEC
        238        DEFINE H2FRAC MOLE-FRAC STREAM=H2PROD SUBSTREAM=MIXED  &
        239            COMPONENT=H2
        240        SPEC "H2FRAC" TO "1"
        241        TOL-SPEC "0.005"
        242        VARY BLOCK-VAR BLOCK=PSA SENTENCE=FRAC VARIABLE=FRACS ID1= &
        243            MIXED ID2=H2PROD ELEMENT=3
        244        LIMITS "0" "0.90"
        245
        246    EO-CONV-OPTI
        247
        248    CALCULATOR AIR-CALC
        249        DEFINE CH4PRCS MOLE-FLOW STREAM=S14 SUBSTREAM=MIXED  &
        250            COMPONENT=CH4 UOM="kmol/hr"
        251        DEFINE O2MASS MASS-FLOW STREAM=AIR SUBSTREAM=MIXED  &
        252            COMPONENT=O2 UOM="kg/hr"
        253        DEFINE N2MASS MASS-FLOW STREAM=AIR SUBSTREAM=MIXED  &
        254            COMPONENT=N2 UOM="kg/hr"
        255        DEFINE COPRCSS MOLE-FLOW STREAM=S14 SUBSTREAM=MIXED  &
        256            COMPONENT=CO UOM="kmol/hr"
        257        DEFINE CH4FUEL MOLE-FLOW STREAM=CH4FUEL SUBSTREAM=MIXED  &
        258            COMPONENT=CH4 UOM="kmol/hr"
        259        DEFINE H2PRCS MOLE-FLOW STREAM=S14 SUBSTREAM=MIXED  &
        260            COMPONENT=H2 UOM="kmol/hr"
        261    F     CH4TOT = CH4PRCS + CH4FUEL
        262
        263    F     O2REQ  = 2*CH4TOT + COPRCS + 0.5*H2PRCS
        264    F     N2REQ  = 3.76 * O2REQ
        265
        266    F     O2MASS = 32 * 1.1 * O2REQ
        267    F     N2MASS = 28 * 1.1 * N2REQ
        268        READ-VARS CH4PRCS COPRCSS CH4FUEL H2PRCS
        269        WRITE-VARS O2MASS N2MASS
        270
        271    CALCULATOR WTR-FEED
        272        DEFINE WTRFEED STREAM-VAR STREAM=WATER SUBSTREAM=MIXED  &
        273            VARIABLE=MOLE-FLOW UOM="kmol/hr"
        274        DEFINE CH4FEED STREAM-VAR STREAM=CH4FEED SUBSTREAM=MIXED  &
        275            VARIABLE=MOLE-FLOW UOM="kmol/hr"
        276    F     WTRFEED = 3.2*CH4FEED
        277        READ-VARS CH4FEED
        278        WRITE-VARS WTRFEED
