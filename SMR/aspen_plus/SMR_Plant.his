        217            SENTENCE=RESULTS UOM="kW"
        218        DEFINE FURNACE BLOCK-VAR BLOCK=FURNACE VARIABLE=NET-DUTY  &
        219            SENTENCE=RESULTS UOM="kW"
        220    F
        221    F     RQRDQ = (-1) * (HEATER1+HEATER2+SMRDUTY)/0.85
        222        SPEC "FURNACE" TO "RQRDQ"
        223        TOL-SPEC "1"
        224        VARY STREAM-VAR STREAM=CH4FUEL SUBSTREAM=MIXED  &
        225            VARIABLE=MASS-FLOW UOM="kg/hr"
        226        LIMITS "1" "10000"
        227
